{
  "manifest_version": 3,
  "name": "Favilla KEY Login QR",
  "short_name": "Favilla Login",
  "version": "0.5.22",
  "description": "Sign in with your Favilla KEY: it notices login pages, asks the KEY, and types after you press ENTER on it. Passwords never reach the browser.",
  "action": {
    "default_title": "Login QR for this site",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "login-qr@favillakey.io",
      "strict_min_version": "115.0"
    }
  },
  "options_ui": {
    "page": "probe.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "bg.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}