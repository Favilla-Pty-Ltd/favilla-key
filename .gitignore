# ─────────────────────────────────────────────────────────────────────────────
# Favilla KEY (FKIO) — .gitignore   [project root]
# Keeps your existing PlatformIO + harness rules, adds secret/build guards.
# ─────────────────────────────────────────────────────────────────────────────

# ── PlatformIO / build (yours, kept) ─────────────────────────────────────────
.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# ── ESP-IDF managed deps — re-fetched by the build, don't track ──────────────
managed_components/

# ── Build output / firmware images ───────────────────────────────────────────
*.bin
*.elf
*.hex
*.map
*.o
*.a
build/

# ── Snapshot / scratch artifacts ─────────────────────────────────────────────
src.zip
*.zip
*.orig
*.bak
*.rej

# ── Harness output (yours, kept) — raw TRNG samples + serial captures ────────
harness/entropy/
harness/*.bin
harness/t_*
harness/*.log
serial.log
harness/dice_kat
harness/*_kat
harness/selftest

# ═════════════════════════════════════════════════════════════════════════════
#  SECRETS & ENTROPY — NEVER COMMIT.  Anchored to DATA extensions so source
#  (.h/.c/.cpp/.inc) is never excluded.
# ═════════════════════════════════════════════════════════════════════════════
*entropy*.bin
*entropy*.csv
*entropy*.dump
*dump*.bin
*reboot*.csv
*reboot*.log
device_*.log
*.serial.log

# fleet-collision corpus (§8.2) — kept permanently, but OUTSIDE the repo
corpus/
harness/corpus/

# key material (data extensions only)
*.key
*.pem
*.der
*.p12
*_priv.bin
*_priv.txt
*nsec*.txt
*seed*.txt
*secret*.txt

# secure boot / flash encryption / attestation signing keys (once they exist)
secure_boot_signing_key*
flash_encryption_key*
*secure_boot*.pem
station_key*
attest_priv*
*attest*.key

# raw capture data - study artefacts, not source
cam_*.txt
acc_*.txt
*_run.txt
captures/

# ── Not source (added 6 Nov 2026, first push to GitHub) ─────────────────────
captures/
diffs/
host_out/
antiexfil-drop/
*.patch
*.diff
build.log
*_run.txt
platformio.ini.good
platformio.ini.mine
sdkconfig.favilla_key_*
desktop.ini

# CTAP test vectors for the host harness (not keys)
!host/*.bin
# 23 Nov 2026 (#56-8): public mainnet headers 1..1111 that run_ember_hdr.sh needs
!g0/tests/data/*.bin
*.o
.vscode/extensions.json

# Vendored ESP-IDF components (reproducible builds): keep every file, test images too
!components/espressif__*/**/*.bin
!components/joltwallet__*/**/*.bin

# ember_exec.py run state (real transactions): never committed
ember_exec_state.json

# Python bytecode from running the tools and their tests
__pycache__/

# the core rebuild (custom_sdkconfig) works in here
.dummy/
